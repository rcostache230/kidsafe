---
import { getCollection, render } from "astro:content";
import { absoluteUrl, breadcrumbData, SITE_AUTHOR, SITE_AUTHOR_URL, SITE_NAME } from "../../../../src/lib/site-identity";
import Base from "../layouts/Base.astro";
import { postSlug } from "../lib/post-path";

export async function getStaticPaths() {
  const posts = await getCollection("posts", (entry) => !entry.data.draft);
  return posts.map((post) => {
    const key = post.data.translationKey;
    const translation = key && posts.find((candidate) =>
      candidate.data.lang !== post.data.lang && candidate.data.translationKey === key
    );
    return {
      params: { slug: postSlug(post) },
      props: { post, translationPath: translation ? `/blog/${postSlug(translation)}` : undefined }
    };
  });
}

const { post, translationPath } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter(({ depth }) => depth === 2);
const lang = post.data.lang;
const canonical = absoluteUrl(`/blog/${postSlug(post)}`);
const indexHref = lang === "ro" ? "/blog" : "/blog/en";
const indexLabel = lang === "ro" ? "Articole" : "Articles";
const contentsLabel = lang === "ro" ? "În acest articol" : "In this article";
const dateLocale = lang === "ro" ? "ro-RO" : "en-US";

const breadcrumbs = breadcrumbData([
  { label: SITE_NAME, href: lang === "ro" ? "/" : "/en" },
  { label: indexLabel, href: indexHref },
  { label: post.data.title }
], canonical);
const articleData = [
  breadcrumbs,
  {
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    mainEntityOfPage: canonical,
    inLanguage: lang,
    datePublished: post.data.publishedAt.toISOString(),
    dateModified: post.data.updatedAt?.toISOString(),
    image: post.data.cover ? absoluteUrl(post.data.cover) : undefined,
    author: {
      "@type": "Person",
      name: post.data.author,
      url: post.data.author === SITE_AUTHOR ? SITE_AUTHOR_URL : undefined
    },
    publisher: { "@type": "Organization", name: SITE_NAME, url: absoluteUrl("/") }
  }
];

function formatDate(date: Date) {
  return new Intl.DateTimeFormat(dateLocale, {
    year: "numeric",
    month: "long",
    day: "numeric"
  }).format(date);
}
---

<Base
  title={post.data.title}
  description={post.data.description}
  lang={lang}
  canonical={canonical}
  translationPath={translationPath}
  articleData={articleData}
  image={post.data.cover}
>
  <article class="article shell">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={lang === "ro" ? "/" : "/en"}>Digital Parents</a>
      <span aria-hidden="true"> › </span>
      <a href={indexHref}>{indexLabel}</a>
      <span aria-hidden="true"> › </span>
      <span>{post.data.title}</span>
    </nav>

    <header class="post-header">
      <p class="eyebrow">{indexLabel}</p>
      <h1 class="page-title">{post.data.title}</h1>
      <div class="meta">
        <time datetime={post.data.publishedAt.toISOString()}>
          {formatDate(post.data.publishedAt)}
        </time>
        <span>·</span>
        <span>{post.data.author}</span>
        {post.data.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
      <p class="page-lede">{post.data.description}</p>
    </header>

    <div class="post-reading">
      {sections.length > 0 && (
        <nav class="contents-panel article-contents" aria-label={contentsLabel}>
          <p class="eyebrow">{contentsLabel}</p>
          <ul>
            {sections.map(({ slug, text }) => <li><a href={`#${slug}`}>{text}</a></li>)}
          </ul>
        </nav>
      )}
      <div class="post-body card">
        {post.data.cover ? (
          <figure class="post-cover">
            <img
              src={post.data.cover}
              alt=""
              loading="eager"
              decoding="async"
            />
          </figure>
        ) : null}
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>
  </article>
</Base>
