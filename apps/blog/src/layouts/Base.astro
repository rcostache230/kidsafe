---
import "../../../../src/app/theme.css";
import "../styles/global.css";
import { creatorUrl, crossPromoCopy, klioUrl } from "../../../../src/lib/cross-promo";
import { absoluteUrl, serializeJsonLd, SITE_NAME } from "../../../../src/lib/site-identity";

interface Props {
  title: string;
  description: string;
  lang?: "en" | "ro";
  canonical?: string;
  image?: string;
  translationPath?: string;
  articleData?: object[];
}

const { title, description, lang = "ro", canonical, image, translationPath, articleData } = Astro.props;
const promo = crossPromoCopy[lang];
const homeHref = lang === "ro" ? "/" : "/en";
const blogHref = lang === "ro" ? "/blog" : "/blog/en";
const defaultAlternate = lang === "ro" ? "/blog/en" : "/blog";
const otherLang = lang === "ro" ? "en" : "ro";
const canonicalUrl = canonical ?? absoluteUrl(blogHref);
const alternatePath = articleData ? translationPath : defaultAlternate;
const switchLangHref = alternatePath ?? defaultAlternate;
const imageUrl = absoluteUrl(image ?? `${homeHref === "/" ? "" : homeHref}/opengraph-image`);
const switchLangLabel = lang === "ro" ? "EN" : "RO";
const navGuides = lang === "ro" ? "Ghiduri" : "Guides";
const navArticles = lang === "ro" ? "Articole" : "Articles";
const navAbout = lang === "ro" ? "Despre" : "About";
const footerCopy =
  lang === "ro"
    ? "© 2026 Digital Parents. Proiect independent realizat de Razvan Costache."
    : "© 2026 Digital Parents. Independent project by Razvan Costache.";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {alternatePath && (
      <>
        <link rel="alternate" hreflang={lang} href={canonicalUrl} />
        <link rel="alternate" hreflang={otherLang} href={absoluteUrl(alternatePath)} />
        <link rel="alternate" hreflang="x-default" href={lang === "ro" ? canonicalUrl : absoluteUrl(alternatePath)} />
      </>
    )}
    <title>{title} | {SITE_NAME}</title>
    <link rel="icon" href="/brand/digitalparents-favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/digitalparents-apple.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={articleData ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />
    {articleData && (
      <script type="application/ld+json" set:html={serializeJsonLd({ "@context": "https://schema.org", "@graph": articleData })} is:inline />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === "ro" ? "Sari la conținut" : "Skip to content"}</a>
    <header class="site-header">
      <div class="shell row">
        <a class="brand-lockup" href={homeHref} aria-label="Digital Parents">
          <img class="brand-logo-image" src="/brand/digitalparents-wordmark.png" alt="" width="1120" height="107" draggable="false" />
        </a>
        <nav class="nav" aria-label="Primary">
          <a href={`${homeHref}#apps`}>{navGuides}</a>
          <a href={blogHref} aria-current={Astro.url.pathname === blogHref ? "page" : undefined}>{navArticles}</a>
          <a href={`${homeHref}#about`}>{navAbout}</a>
          <a href={klioUrl} target="_blank" rel="noopener noreferrer" aria-label={promo.klioLabel} title={promo.klioDescription} class="klio-link">Klio <span aria-hidden="true">↗</span></a>
        </nav>
        <a class="lang-switch" href={switchLangHref} hreflang={otherLang} aria-label={switchLangLabel === "RO" ? "Switch to Romanian" : "Switch to English"}>
          {switchLangLabel}
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <section class="creator-projects" aria-labelledby="creator-projects-title">
          <h2 id="creator-projects-title">{promo.heading}</h2>
          <div class="creator-project-links">
            <div>
              <a href={creatorUrl} target="_blank" rel="noopener noreferrer">Razvan Costache <span aria-hidden="true">↗</span></a>
              <p>{promo.creatorDescription}</p>
            </div>
            <div>
              <a href={klioUrl} target="_blank" rel="noopener noreferrer" aria-label={promo.klioLabel}>Klio <span aria-hidden="true">↗</span></a>
              <p>{promo.klioDescription}</p>
            </div>
          </div>
        </section>
        <p>{footerCopy}</p>
        <p style="margin-top:0.5rem;">
          <a href={homeHref}>{lang === "ro" ? "Înapoi la ghiduri" : "Back to guides"}</a>
          ·
          <a href="https://www.linkedin.com/in/rcostache/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </p>
      </div>
    </footer>
  </body>
</html>
